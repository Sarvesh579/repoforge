// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Team registration ───────────────────────────────────────────────────────

model Team {
  id                   String   @id @default(cuid())
  name                 String
  join_code            String   @unique
  theme_track          String   @default("")
  problem_statement_id String   @default("")
  problem_statement    String   @default("") @db.Text
  lead_email           String   @unique
  phone                String
  college              String
  year                 String
  dept                 String   @default("")
  created_at           DateTime @default(now())

  members     TeamMember[]
  credential  Credential?
  submission  Submission?
  payment  Payment?
  participantId ParticipantId?
  result      Result?

  @@map("teams")
}

model TeamMember {
  id        String   @id @default(cuid())
  team_id   String
  name      String
  email     String
  phone     String   @default("")
  role      TeamRole @default(member)
  custom_role String @default("")
  year      String   @default("")
  dept      String   @default("")
  joined_at DateTime @default(now())

  team Team @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@map("team_members")
}

enum TeamRole {
  lead
  member
}

// ─── Credentials (auto-generated, hashed) ────────────────────────────────────

model Credential {
  id            String    @id @default(cuid())
  team_id       String    @unique
  password_hash String
  email_sent_at DateTime?
  created_at    DateTime  @default(now())

  team Team @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@map("credentials")
}

// ─── File submission ──────────────────────────────────────────────────────────

model Submission {
  id           String   @id @default(cuid())
  team_id      String   @unique
  file_path    String   // path inside Supabase bucket
  original_name String
  mime_type    String
  size_bytes   Int
  version      Int      @default(1)
  submitted_at DateTime @default(now())
  locked       Boolean  @default(false)

  team        Team         @relation(fields: [team_id], references: [id], onDelete: Cascade)
  evaluations Evaluation[]

  @@map("submissions")
}

// ─── Judge / Admin users ──────────────────────────────────────────────────────

model JudgeUser {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password_hash String
  role          JudgeRole @default(judge)
  created_at    DateTime  @default(now())

  evaluations Evaluation[]

  @@map("judge_users")
}

enum JudgeRole {
  admin
  judge
}

// ─── Evaluations (judge scores) ───────────────────────────────────────────────

model Evaluation {
  id            String   @id @default(cuid())
  submission_id String
  judge_id      String
  score         Int      // 0–100
  remarks       String   @db.Text @default("")
  submitted_at  DateTime @default(now())
  updated_at    DateTime @updatedAt

  submission Submission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  judge      JudgeUser  @relation(fields: [judge_id], references: [id], onDelete: Cascade)

  @@unique([submission_id, judge_id]) // one score per judge per submission
  @@map("evaluations")
}

// ─── Results (shortlist + rankings) ──────────────────────────────────────────

model Result {
  id              String   @id @default(cuid())
  team_id         String   @unique
  rank            Int?
  shortlisted     Boolean  @default(false)
  shortlist_status String  @default("Under-Review")
  published       Boolean  @default(false)
  updated_at      DateTime @updatedAt

  team Team @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@map("results")
}

// ─── Announcements ────────────────────────────────────────────────────────────

model Announcement {
  id         String   @id @default(cuid())
  title      String
  detail     String   @db.Text
  created_at DateTime @default(now())

  @@map("announcements")
}

// ─── Problem statement tracks ─────────────────────────────────────────────────

model Track {
  id                String @id @default(cuid())
  title             String
  category          String @default("General")
  short_description String @default("")
  description       String @db.Text @default("")
  difficulty        String @default("Intermediate")
  reward            String @default("")
  tags        String[] @default([])
  teams             Int    @default(0)
  published   Boolean  @default(false) // <--- Add this line

  @@map("tracks")
}

// ─── Registration window flag ─────────────────────────────────────────────────

model RegistrationWindow {
  id   Int     @id @default(autoincrement())
  open Boolean @default(true)

  @@map("registration_window")
}


model Payment {
  id            String   @id @default(uuid())
  team_id       String   @unique
  team          Team     @relation(fields: [team_id], references: [id], onDelete: Cascade)
  file_path     String
  original_name String
  status        String   @default("Pending")
  is_paid       Boolean  @default(false)
  uploaded_at   DateTime @default(now())

  @@map("payments")
}



model Notification {
  id         String   @id @default(cuid())
  title      String
  time       String   @default("")
  unread     Boolean  @default(true)
  detail     String   @db.Text
  created_at DateTime @default(now())

  @@map("notifications")
}

model ParticipantId {
  id            String   @id @default(uuid())
  team_id       String   @unique
  team          Team     @relation(fields: [team_id], references: [id], onDelete: Cascade)
  file_path     String
  original_name String
  uploaded_at   DateTime @default(now())

  @@map("participant_ids")
}

model HackathonSetting {
  id                   Int      @id @default(1)
  name                 String   @default("CRUCIBLE Hackathon 2026")
  year                 Int      @default(2026)
  deadline             String   @default("2026-08-30")
  payment_deadline     String   @default("")
  hackathonStatus      String   @default("Live") // 'Live' | 'Paused' | 'Closed'
  registrationStatus   String   @default("Open") // 'Open' | 'Closed'
  acceptingSubmissions Boolean  @default(true)   // <--- Controls PPT submissions
  updated_at           DateTime @updatedAt

  @@map("hackathon_settings")
}